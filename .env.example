# ─── Database ───────────────────────────────────────────────────────────────
# Local development: a SQLite file (no database server needed).
# Production (Vercel + Neon): the Postgres connection string Vercel provides.
DATABASE_URL=file:./dev.db

# Long random string used to sign logins. REQUIRED in production.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public address of the site (used in admin links and emails).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── File storage (production) ──────────────────────────────────────────────
# Set automatically when you add Vercel Blob to the project. Without it, uploads
# are stored on local disk (fine for development only).
BLOB_READ_WRITE_TOKEN=

# ─── Email (optional but recommended) ───────────────────────────────────────
# Needed for "Forgot password" emails and enquiry alerts. Any SMTP service works,
# e.g. Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@transitionventurecapital.com

# Where to send an alert when someone submits a website form (optional).
SUBMISSIONS_NOTIFY_EMAIL=

# Advanced: send forms somewhere other than the built-in inbox (leave empty).
NEXT_PUBLIC_FORMS_ENDPOINT=
